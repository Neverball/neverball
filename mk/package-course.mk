# Generated by Antigravity CLI 1.4.3 (Gemini 3.8 Flash (High))
#
# Make a package for a Neverputt course. SOLs must already be compiled.
#
# Usage:
#
#   make -f package-course.mk PACKAGE_ID=course-putt COURSE_FILE=./data/holes-putt.txt DATA_DIR=./data

ifndef COURSE_FILE
$(error COURSE_FILE is missing. ./data/holes-putt.txt, etc.)
endif

ifndef PACKAGE_ID
$(error PACKAGE_ID is missing. Format: course-putt, etc.)
endif

ifndef DATA_DIR
$(error DATA_DIR is missing. Format: ./data, etc.)
endif

OUTPUT_DIR ?= $(shell pwd)/packages

COURSE_SHOT := $(shell sed -n 's/\r$$//; 1 p' < $(COURSE_FILE))
COURSE_DESC := $(shell sed -n 's/\r$$//; 2 s,\\,\\n,g; 2 p' < $(COURSE_FILE))
COURSE_SOLS := $(sort $(shell sed -n 's/\r$$//; 3,$$ s/^\([^ ]*\).*/\1/p' < $(COURSE_FILE)))

ifeq ($(PACKAGE_ID),course-putt)
COURSE_NAME ?= Neverputt
else ifeq ($(PACKAGE_ID),course-abc)
COURSE_NAME ?= Alphabet
else ifeq ($(PACKAGE_ID),course-iCourse)
COURSE_NAME ?= Reshaun's iPutt
else
COURSE_NAME ?= $(shell sed -n 's/\r$$//; 2 s/\\.*//; 2 p' < $(COURSE_FILE))
endif
ifeq ($(strip $(COURSE_NAME)),)
COURSE_NAME := $(PACKAGE_ID)
endif

ASSET_PATHS := $(notdir $(COURSE_FILE)) $(COURSE_SHOT) $(COURSE_SOLS)

PACKAGE_MANIFEST := $(OUTPUT_DIR)/$(PACKAGE_ID).manifest.txt
PACKAGE_SCREENSHOT := $(OUTPUT_DIR)/$(PACKAGE_ID)-$(shell md5sum $(DATA_DIR)/$(COURSE_SHOT) | cut -c -32)$(suffix $(COURSE_SHOT))

all: package manifest screenshot

package:
	$(MAKE) -f mk/package.mk PACKAGE_ID=$(PACKAGE_ID) DATA_DIR=$(DATA_DIR) ASSET_PATHS="$(ASSET_PATHS)" OUTPUT_DIR=$(OUTPUT_DIR)

manifest: package
	printf 'files %s %s\nname %s\ndesc %s\nshot %s\n' \
		$(notdir $(COURSE_FILE)) "$(COURSE_SOLS)" "$(COURSE_NAME)" "$(COURSE_DESC)" $(notdir $(PACKAGE_SCREENSHOT)) >> $(PACKAGE_MANIFEST)

screenshot: package manifest
	cp $(DATA_DIR)/$(COURSE_SHOT) $(PACKAGE_SCREENSHOT)

.PHONY: all package screenshot manifest

GNUMAKEFLAGS = --no-print-directory
