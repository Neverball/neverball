#
# Populate unbundled background data files for web renderer.
#

DATA_DIR ?= ./data
OUTPUT_DIR ?= $(CURDIR)/js/data

.PHONY: all clean bg-data

all: bg-data

bg-data:
	mkdir -p $(OUTPUT_DIR)/geom/back $(OUTPUT_DIR)/back $(OUTPUT_DIR)/map-back $(OUTPUT_DIR)/png
	cp $(DATA_DIR)/geom/back/back.sol $(OUTPUT_DIR)/geom/back/
	cp $(DATA_DIR)/back/*.png $(OUTPUT_DIR)/back/
	cp $(DATA_DIR)/map-back/*.sol $(OUTPUT_DIR)/map-back/
	for img in $$(grep -ho '"image"[[:space:]]*"[^"]*"' $(DATA_DIR)/map-back/*.map | sed 's/"image"[[:space:]]*"//;s/"//' | sort -u); do \
		cp $(DATA_DIR)/$$img.png $(OUTPUT_DIR)/png/; \
	done

clean:
	rm -rf $(OUTPUT_DIR)
